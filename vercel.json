{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {"source": "/about", "destination": "/index.html"},
    {"source": "/contact", "destination": "/index.html"},
    {"source": "/tools", "destination": "/index.html"},
    {"source": "/opportunities", "destination": "/index.html"},
    {"source": "/opportunities/:slug", "destination": "/index.html"},
    {"source": "/events", "destination": "/index.html"},
    {"source": "/events/:slug", "destination": "/index.html"}
  ],
  "headers": [
    {"source": "/assets/(.*)", "headers": [{"key": "Cache-Control", "value": "public, max-age=3600"}]},
    {"source": "/(.*)", "headers": [
      {"key": "X-Content-Type-Options", "value": "nosniff"},
      {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"},
      {"key": "X-Frame-Options", "value": "SAMEORIGIN"}
    ]}
  ]
}
